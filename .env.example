# Neon Auth (Managed Better Auth) — used for sign-in and JWT issuance
VITE_NEON_AUTH_URL=https://YOUR_ENDPOINT.neonauth.EU_WEST_2.aws.neon.tech/neondb/auth

# Neon Data API (PostgREST-compatible) — used for tables and RPC calls
VITE_NEON_DATA_API_URL=https://YOUR_ENDPOINT.apirest.EU_WEST_2.aws.neon.tech/neondb/rest/v1

# Server-side only (scripts / migrations). Never expose to the browser.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Maintenance scripts sign in as an existing admin. Keep these in .env.local only.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=…
